#!/usr/bin/make -f
#
# This debian/rules uses debhelper.
#

%:
	dh $@ --with yang

override_dh_installsystemd:
	dh_installsystemd -p vyatta-service-snmp --name=vyatta-buffer-congestion-notifier --no-start vyatta-buffer-congestion-notifier.service
	dh_installsystemd -p vyatta-service-snmp --name=vyatta-storm-ctl-notifier --no-start vyatta-storm-ctl-notifier.service
	dh_installsystemd -p vyatta-service-snmp --name=vyatta-snmp-subagent --no-start vyatta-snmp-subagent.service
	dh_installsystemd -p vyatta-service-snmp --name=vyatta-entity-mibs-subagent --no-start vyatta-entity-mibs-subagent.service
	dh_installsystemd -p vyatta-service-snmp --name=vyatta-ptp-mib-subagent --no-start vyatta-ptp-mib-subagent.service
	dh_installsystemd -p vyatta-service-snmp --name=vyatta-reboot-reason-notifier --no-start vyatta-reboot-reason-notifier.service
	dh_installsystemd --name=snmptrapd --no-enable --no-start
	dh_installsystemd -p vyatta-entity-sensor-subagent --name=snmp-entsensor-trap --no-start snmp-entsensor-trap.service

